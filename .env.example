# Copy to .env and fill in.
#
# The marketing pages need only the SMTP block. The hiring assistant — /apply,
# /admin and the /api/{auth,quiz,resume,roles,admin} routes — needs the database
# block as well; without it those routes build fine but fail at request time.

# ── Mail (contact form, demo requests) ──────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Hiring assistant ────────────────────────────────────────────────────────

# Postgres connection string. Tables and the question bank create and seed
# themselves on the first request, so there is no migration step to run.
#
# Local Postgres:
DATABASE_URL=postgres://user:password@localhost:5432/arnobot
#
# Hosted Postgres (Neon, Supabase, Railway, RDS, …) requires SSL — append
# ?sslmode=require:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# POSTGRES_URL and POSTGRES_PRISMA_URL are also read, in that order, so a
# provider that injects one of those needs no extra configuration.

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me

# Long random string signing the attempt and admin-session tokens. Changing it
# invalidates every in-flight assessment and signs every admin out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# Optional assessment tuning — defaults shown, all overridable from /admin.
QUIZ_QUESTIONS_PER_TEST=20
QUIZ_PASS_PERCENT=70
QUIZ_TIME_LIMIT_MIN=20
