  }



  .facility-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .facility-gallery {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-card);
  }

  .leadership .section-title {
    text-align: center;
  }

  .facility-left {
    text-align: center;
    align-items: center;
  }
}

/* ── MOBILE VIEWPORTS (under 580px) ───────────────────────────────────── */
@media (max-width: 580px) {
  .hero {
    height: 520px;
  }

  .hero-bg,
  .hero-video {
    height: 520px;
  }

  .hero-content {
    padding-top: clamp(140px, 25vh, 200px);
    padding-left: 16px;
    padding-right: 16px;
  }

  .hero h1 {
    font-size: 26px;
  }

  .hero-sub {
    font-size: var(--fs-body-sm);
  }

  .hero-play {
    width: 90px;
    height: 90px;
  }

  .metrics {
    grid-template-columns: 1fr;
    gap: var(--gap-card);
  }

  .product-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .cta-container {
    align-items: center;
    text-align: center;
  }

  .cta h2 {
    font-size: 26px;
  }

  .cta-sub {
    font-size: var(--fs-body-sm);
  }

  .cta-actions {
    flex-direction: column;
    width: 100%;
    gap: 12px;
  }

  .btn-cta-primary {
    width: 100%;
    max-width: 280px;
  }

  .about-hero {
    padding: 60px 16px 30px 16px;
  }

  .vision-mission-cards {
    width: 100%;
    left: auto;
    margin-left: auto;
    margin-right: auto;
    margin-top: -40px;
    padding: 0;
  }

  .vision-mission-card {
    padding: 48px 20px 28px;
  }

  .vision-mission-card h3 {
    font-size: 20px;
  }

  .vision-mission-card p {
    font-size: var(--fs-sm);
    line-height: 1.5;
  }



  .facility-gallery {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .facility-left h2 {
    font-size: 28px;
  }

  .facility-caption {
    flex-direction: column;
    text-align: center;
    width: 100%;
  }

  .leadership .section-title {
    font-size: 24px;
  }
}

/* ── VIDEO LIGHTBOX MODAL ──────────────────────────────────────────────── */
.video-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--t-slow) ease;
}

.video-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.video-modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(var(--ink-rgb), 0.82);
  backdrop-filter: blur(10px);
}

.video-modal-container {
  position: relative;
  width: min(90vw, 960px);
  aspect-ratio: 16 / 9;
  background: #000;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
  transform: scale(0.85);
  opacity: 0;
  transition: transform var(--t-slower) var(--ease-spring), opacity var(--t-slow) ease;
  z-index: 2;
}

.video-modal.active .video-modal-container {
  transform: scale(1);
  opacity: 1;
}

.video-modal-close {
  position: absolute;
  top: -45px;
  right: 0;
  background: none;
  border: none;
  color: var(--white);
  font-size: 36px;
  line-height: 1;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity var(--t-fast) ease, transform var(--t-fast) ease;
  z-index: 3;
}

.video-modal-close:hover {
  opacity: 1;
  transform: scale(1.1);
}

.video-modal-content {
  width: 100%;
  height: 100%;
}

.video-modal-content video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}

/* Modal responsive adjustments */
@media (max-width: 768px) {
  .video-modal-close {
    top: 10px;
    right: 15px;
    background: rgba(0, 0, 0, 0.5);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-round);
    font-size: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
}



/* Details Section */
.product-details {
  background: var(--white);
  padding: var(--section-pad-lg) 0;
}

.product-details-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 80px;
  align-items: center;
}

.product-details-image img {
  width: 100%;
  /*height: auto;*/
  border-radius: var(--radius-3xl);
  box-shadow: 0 20px 40px rgba(var(--ink-rgb), 0.08);
  display: block;
}

.product-details-copy {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.product-name {
  font-size: 42px;
  color: var(--ink);
  margin-bottom: 2px;
}

.product-subtitle {
  font-size: var(--fs-body-xl);
  color: var(--muted);
  font-weight: var(--fw-semibold);
  display: block;
  margin-top: -10px;
}

.product-desc {
  font-size: var(--fs-body);
  line-height: 1.62;
  color: var(--muted);
  margin-bottom: 15px;
}

.product-specs {
  border-top: 1px solid rgba(var(--ink-rgb), 0.1);
  padding-top: 25px;
}

@media (max-width: 1023px) {
  .product-hero {
    height: 480px;
  }

  .product-details {
    padding: var(--section-pad-sm) 0;
  }

  .product-details-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

@media (max-width: 580px) {
  .product-hero {
    height: 380px;
  }

  .product-name {
    font-size: var(--fs-h2-lg);
  }

  .product-subtitle {
    font-size: var(--fs-body-md);
  }
}

/* Specs Simple List */
.specs-simple-list {
  padding: 0;
  margin: 20px 0 35px 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.specs-simple-list li {
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--muted);
}

.specs-simple-list li strong {
  color: var(--ink);
  font-weight: var(--fw-semibold);
  margin-right: 6px;
}

/* Product Actions / Buttons */
.product-actions {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
}

.prod-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  padding: 0 28px;
  border-radius: var(--radius-sm);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-semibold);
  text-decoration: none;
  transition: all var(--t-base) ease;
  border: none;
  cursor: pointer;
}

.btn-blue {
  background: var(--accent);
  color: var(--white);
}

.btn-blue:hover {
  background: #2b4c80;
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(var(--accent-rgb), 0.25);
}

.btn-black {
  background: var(--ink);
  color: var(--white);
}

.btn-black:hover {
  background: var(--btn-bg-hover);
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(var(--ink-rgb), 0.2);
}

/* Specs Section with Cards */
.product-specs-section {
  padding: var(--section-pad-lg) 0;
  background-color: #f8f9fa;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.specs-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.specs-card {
  background: var(--white);
  border-radius: var(--radius-4xl);
  padding: 50px 60px;
  box-shadow: 0 15px 35px rgba(var(--ink-rgb), 0.04);
  border: 1px solid rgba(var(--ink-rgb), 0.03);
}

.card-title {
  font-size: 28px;
  color: var(--ink);
  margin-bottom: 24px;
  letter-spacing: 1px;
}

.specs-bullet-list {
  padding: 0;
  margin: 0;
  list-style: none;
}

.specs-bullet-list li {
  position: relative;
  padding-left: 20px;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--muted);
  margin-bottom: 14px;
}

.specs-bullet-list li::before {
  content: "•";
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: bold;
  font-size: 20px;
  line-height: 1;
  top: -1px;
}

.specs-bullet-list li:last-child {
  margin-bottom: 0;
}

/* Responsive adjustments */
@media (max-width: 1023px) {
  .product-specs-section {
    padding: var(--section-pad-sm) 0;
  }

  .specs-cards-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .specs-card {
    padding: 40px 30px;
  }
}

/* Showcase Section */
.product-showcase-section {
  padding: var(--section-pad-lg) 0;
  background: var(--white);
}

.showcase-header {
  margin-bottom: 50px;
}

.showcase-title {
  font-size: var(--fs-h1-lg);
  color: var(--ink);
  letter-spacing: 1px;
}

.showcase-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.showcase-item {
  display: flex;
  flex-direction: column;
}

.showcase-card {
  position: relative;
  height: 520px;
  /* Fixed height */
  border-radius: 18px;
  overflow: hidden;
  cursor: pointer;
}

.showcase-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.showcase-name {
  margin-top: 15px;
  text-align: center;
  color: var(--title-ink);
  font-size: var(--fs-body-xl);
  font-weight: var(--fw-semibold);
}

.showcase-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--t-slowest) ease;
}

.showcase-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(var(--ink-rgb), 0.1), rgba(var(--ink-rgb), 0.4));
  z-index: 2;
  transition: opacity var(--t-med) ease;
}

.showcase-play-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 76px;
  height: 76px;
  z-index: 3;
  opacity: 0.85;
  transition: transform var(--t-med) ease, opacity var(--t-med) ease;
}

.showcase-card:hover .showcase-img {
  transform: scale(1.05);
}

.showcase-card:hover .showcase-play-icon {
  transform: translate(-50%, -50%) scale(1.1);
  opacity: 1;
}

/* Responsive adjustments */
@media (max-width: 1023px) {
  .product-showcase-section {
    padding: var(--section-pad-sm) 0;
  }

  .showcase-grid {
    grid-template-columns: 1fr;
    gap: var(--gap-card);
  }

  .showcase-card {
    height: 400px;
  }
}

