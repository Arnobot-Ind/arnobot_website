/* Design tokens (colors, fonts, type scale, radii, shadows, spacing, motion)
   live in theme.css — the central theme file loaded before this one by
   SiteChrome.tsx. Change values there, not here. */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
  max-width: 100%;
}

body {
  background: var(--page);
  color: var(--ink);
  font-family: var(--font-body);
  overflow-x: hidden;
  max-width: 100%;
  width: 100%;
}

.site {
  background: var(--white);
  overflow-x: hidden;
  max-width: 100%;
  width: 100%;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

.container {
  width: min(100% - 170px, 1270px);
  margin: 0 auto;
}

.russo,
.eyebrow,
.section-title {
  font-family: var(--font-display);
  font-weight: var(--fw-regular);
  text-transform: uppercase;
}

.eyebrow {
  display: block;
  color: var(--accent);
  font-size: var(--fs-eyebrow);
  letter-spacing: 3px;
  line-height: 1.2;
  margin-bottom: 16px;
}

.section-title {
  color: var(--title-ink);
  font-size: var(--fs-h2);
  letter-spacing: 1.4px;
  line-height: 1.18;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--btn-w);
  height: var(--btn-h);
  border-radius: var(--btn-radius);
  background: var(--btn-bg);
  color: var(--btn-fg);
  font-size: var(--btn-fs);
  font-weight: var(--btn-fw);
  transition: transform var(--t-base) ease, box-shadow var(--t-base) ease, background var(--t-base) ease;
}

.btn:hover {
  background: var(--btn-bg-hover);
  box-shadow: var(--shadow-btn-hover);
  transform: translateY(-2px);
}

.header {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 95%;
  z-index: 999;
}

.header-inner {
  height: 80px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 100px;

  background: rgba(var(--white-rgb), .15);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);

  border: 1px solid rgba(var(--white-rgb), .25);
  border-radius: var(--radius-3xl);

  box-shadow: var(--shadow-header);
}

.logo {
  width: 220px;
  display: block;
}

.logo-wrap {
  flex: 0 0 auto;
}

@media (max-width: 768px) {

  /* Desktop navigation hide */
  .main-nav {
    display: none !important;
  }

  /* Hamburger button show */
  .nav-toggle {
    display: flex !important;
  }

  /* Header alignment */
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }

  .logo-wrap {
    margin-left: 0;
  }

  .logo {
    width: 170px;
    max-height: 46px;
    object-fit: contain;
  }

}

.main-nav {
  display: flex;
  align-items: center;
  gap: 52px;

  margin-left: 60px;
  /*margin-right:auto;*/
}

.main-nav a {
  text-decoration: none;
  color: var(--nav-ink);
  font-weight: var(--fw-medium);
  font-size: var(--fs-nav);
  letter-spacing: 0.06em;
}

.main-nav>a,
.nav-dropdown {
  display: flex;
  align-items: center;
}

/*.header-btn:hover{*/
/*    background:#264dbb;*/
/*}*/
/* ── DESKTOP DROPDOWN ───────────────────────────────────────────────────── */

.nav-dropdown {
  position: static;
  /* stay in normal nav flow */
  display: inline-flex;
  align-items: center;
}

/* The wrapper that actually anchors the floating card */
.nav-dropdown-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 100%;
}

.nav-dropdown-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  position: relative;
  /*padding-bottom: 7px;*/
  transition: color var(--t-fast) ease;
  cursor: pointer;
  white-space: nowrap;
}

.nav-dropdown-toggle::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform var(--t-fast) ease;
}

.nav-dropdown.open .nav-dropdown-toggle,
.nav-dropdown-toggle:focus-visible {
  color: var(--accent);
}

.nav-dropdown.open .nav-dropdown-toggle::after,
.nav-dropdown-toggle:focus-visible::after {
  transform: scaleX(1);
}

.dropdown-caret {
  flex-shrink: 0;
  transition: transform var(--t-base) ease;
}

.nav-dropdown.open .dropdown-caret {
  transform: rotate(180deg);
}

/* ── The floating card itself ── */
.dropdown-menu {
  position: fixed;
  /* fixed so header height / overflow never clips it */
  /* top & left are set via JS — see main.js positionDropdown() */
  min-width: 220px;
  background: var(--white);
  border: 1px solid rgba(var(--ink-rgb), .10);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-dropdown);
  padding: 6px;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-6px) scale(.97);
  transform-origin: top center;
  transition:
    opacity var(--t-fast) ease,
    transform var(--t-fast) var(--ease-menu),
    visibility 0s linear var(--t-fast);
  z-index: 9999;
}

/* small upward arrow pointer */
.dropdown-menu::before {
  content: "";
  position: absolute;
  top: -7px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 13px;
  height: 13px;
  background: var(--white);
  border-left: 1px solid rgba(var(--ink-rgb), .10);
  border-top: 1px solid rgba(var(--ink-rgb), .10);
  border-radius: 2px 0 0 0;
}

.nav-dropdown.open .dropdown-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0) scale(1);
  transition:
    opacity var(--t-fast) ease,
    transform var(--t-fast) var(--ease-menu),
    visibility 0s linear 0s;
}

.dropdown-menu li {
  list-style: none;
}

.dropdown-menu li+li {
  border-top: 1px solid rgba(var(--ink-rgb), .055);
}

.dropdown-menu li a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px;
  font-size: var(--fs-xs);
  font-weight: var(--fw-bold);
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: 1px;
  border-radius: 9px;
  transition: color var(--t-quick) ease, background var(--t-quick) ease, gap var(--t-quick) ease;
  white-space: nowrap;
}

/* suppress the nav-level underline pseudo-element on submenu links */
.dropdown-menu li a::after {
  display: none !important;
}

/* accent dot bullet */
.dropdown-menu li a::before {
  content: "";
  display: block;
  width: 6px;
  height: 6px;
  border-radius: var(--radius-round);
  background: var(--accent);
  opacity: 0;
  flex-shrink: 0;
  transition: opacity var(--t-quick) ease;
}

.dropdown-menu li a:hover,
.dropdown-menu li a:focus-visible {
  color: var(--accent);
  background: rgba(var(--accent-rgb), .07);
  gap: 14px;
}

.dropdown-menu li a:hover::before,
.dropdown-menu li a:focus-visible::before {
  opacity: 1;
}

.dropdown-menu li:first-child a {
  border-radius: 9px 9px 4px 4px;
}

.dropdown-menu li:last-child a {
  border-radius: 4px 4px 9px 9px;
}

.dropdown-menu li:only-child a {
  border-radius: 9px;
}

.dropdown-menu li a.active {
  color: var(--accent);
  background: rgba(var(--accent-rgb), .09);
}

.hero {
  position: relative;
  min-height: calc(100vh - 90px);
  height: 895px;
  overflow: hidden;
  background: var(--bg);
}

.hero-video {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  pointer-events: none;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 2;
  opacity: 0.45;
  pointer-events: none;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(var(--bg-rgb), .90) 0%, rgba(var(--bg-rgb), .75) 43%, rgba(var(--bg-rgb), .48) 100%),
    radial-gradient(circle at 52% 60%, rgba(var(--accent-rgb), .16), transparent 26%);
  z-index: 3;
}

.hero-content {
  position: relative;
  z-index: 4;
  padding-left: var(--gutter);
  padding-top: clamp(250px, 34vh, 386px);
}

.hero h1 {
  max-width: 946px;
  color: var(--title-ink);
  font-size: var(--fs-h1);
  letter-spacing: 2px;
  line-height: 1.2;
  text-shadow: 0 8px 32px rgba(var(--white-rgb), .5);
}

.hero .btn {
  margin-top: 27px;
}

.hero-sub {
  width: min(100%, 560px);
  margin-top: 16px;
  color: #202431;
  font-size: var(--fs-body-xl);
  line-height: 1.45;
  font-weight: var(--fw-medium);
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  margin-top: 27px;
}

.hero-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 9999;

  width: 163px;
  height: 163px;

  opacity: 1 !important;
  visibility: visible !important;
  display: block !important;

  cursor: pointer;
}

.hero-play:hover {
  transform: translate(-50%, -50%) scale(1.08);
}

.about {
  min-height: 704px;
  padding-top: var(--section-pad);
  background: var(--white);
}

.about-grid {
  display: grid;
  grid-template-columns: 599px 455px;
  gap: 93px;
  align-items: end;
  width: 100%;
  max-width: 1147px;
  margin: 0 auto;
}

.about-images {
  position: relative;
  width: 100%;
  height: auto;
  aspect-ratio: 599 / 524;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.about-animated-circles {
  position: absolute;
  top: 48%;
  left: 50%;
  width: 125%;
  height: 125%;
  max-width: 720px;
  max-height: 720px;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Soft ambient breathing aura */
.radar-aura {
  position: absolute;
  width: 90%;
  height: 90%;
  border-radius: var(--radius-round);
  background: radial-gradient(circle, rgba(var(--accent-deep-rgb), 0.08) 0%, rgba(var(--accent-deep-rgb), 0.02) 50%, rgba(var(--white-rgb), 0) 70%);
  animation: auraBreathe 6s ease-in-out infinite alternate;
  pointer-events: none;
}

@keyframes auraBreathe {
  0% {
    transform: scale(0.92);
    opacity: 0.5;
  }

  100% {
    transform: scale(1.06);
    opacity: 0.9;
  }
}

/* Subtle continuous radar sweep beam */
.radar-sweep-beam {
  position: absolute;
  width: 95%;
  height: 95%;
  border-radius: var(--radius-round);
  background: conic-gradient(from 0deg, transparent 0deg, transparent 280deg, rgba(var(--accent-deep-rgb), 0.09) 360deg);
  -webkit-mask-image: radial-gradient(circle, black 30%, transparent 69%);
  mask-image: radial-gradient(circle, black 30%, transparent 69%);
  animation: sweepRotate 14s linear infinite;
  pointer-events: none;
}

@keyframes sweepRotate {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

/* SVG Radar Precision Rings */
.tech-radar-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.radar-spin-slow {
  transform-origin: 350px 350px;
  animation: spinClockwise 48s linear infinite;
}

.radar-spin-reverse {
  transform-origin: 350px 350px;
  animation: spinCounterClockwise 38s linear infinite;
}

.radar-spin-mid {
  transform-origin: 350px 350px;
  animation: spinClockwise 30s linear infinite;
}

.radar-spin-inner {
  transform-origin: 350px 350px;
  animation: spinCounterClockwise 22s linear infinite;
}

.about-images:hover .radar-spin-slow {
  animation-duration: 25s;
}

.about-images:hover .radar-spin-reverse {
  animation-duration: 20s;
}

.about-images:hover .radar-spin-mid {
  animation-duration: 16s;
}

.about-images:hover .radar-spin-inner {
  animation-duration: 12s;
}

.about-images:hover .radar-sweep-beam {
  animation-duration: 8s;
}

@keyframes spinClockwise {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

@keyframes spinCounterClockwise {
  0% {
    transform: rotate(360deg);
  }

  100% {
    transform: rotate(0deg);
  }
}

.about-img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  filter: drop-shadow(0 15px 35px rgba(var(--ink-rgb), 0.08));
  transition: transform var(--t-slower) ease, filter var(--t-slower) ease;
}

.about-images:hover .about-img {
  transform: translateY(-4px);
  filter: drop-shadow(0 20px 45px rgba(var(--ink-rgb), 0.12));
}

.about-copy {
  padding-bottom: 16px;
}

.about-copy p {
  width: 455px;
  margin: 23px 0 27px;
  color: var(--title-ink);
  font-size: var(--fs-body-lg);
  line-height: 1.42;
}

.excellence {
  min-height: 300px;
  height: auto;
  padding: var(--section-pad-sm) var(--gutter);
  position: relative;
  background:
    linear-gradient(rgba(var(--bg-rgb), .92), rgba(var(--bg-rgb), .92)),
    url("../images/excellence-bg.png") center/cover no-repeat;
  display: flex;
  justify-content: space-around;
  align-items: center;
  max-width: 100%;
  margin: 0;
  width: 100%;
}

.metrics {
  position: relative;
  left: 0;
  top: 0;
  width: 542px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px 40px;
}

.metric {
  display: grid;
  grid-template-columns: 58px 1fr;
  gap: 14px;
  align-items: center;
  min-height: 68px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  background: rgba(var(--white-rgb), 0.45);
  border: 1px solid rgba(var(--accent-deep-rgb), 0.08);
  transition: transform var(--t-slow) var(--ease-lift), box-shadow var(--t-slow) ease, background var(--t-slow) ease, border-color var(--t-slow) ease;
}

.metric:hover {
  transform: translateY(-4px);
  background: rgba(var(--white-rgb), 0.9);
  border-color: rgba(var(--accent-deep-rgb), 0.2);
  box-shadow: 0 10px 25px rgba(var(--accent-deep-rgb), 0.08);
}

.metric img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  transition: transform var(--t-slower) var(--ease-spring);
}

.metric:hover img {
  transform: scale(1.08) rotate(4deg);
}

.metric strong {
  display: block;
  font-size: 25px;
  line-height: 1;
  font-weight: var(--fw-bold);
  color: var(--ink);
  transition: color var(--t-med) ease;
}

.metric:hover strong {
  color: var(--accent-deep);
}

.metric span {
  display: block;
  margin-top: 3px;
  color: var(--ink);
  font-size: var(--fs-body);
  line-height: 1.1;
}

.excellence-line {
  position: absolute;
  left: var(--gutter);
  right: var(--gutter);
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, rgba(96, 103, 116, 0) 0%, rgba(var(--accent-deep-rgb), 0.35) 50%, rgba(96, 103, 116, 0) 100%);
  background-size: 200% 100%;
  animation: scanLineMove 6s linear infinite;
}

@keyframes scanLineMove {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: -100% 0;
  }
}

.products {
  min-height: 591px;
  padding-top: var(--section-pad);
  text-align: center;
  background: var(--white);
}

.product-head {
  width: 503px;
  margin: 0 auto 41px;
}

.product-head p,
.industries-head p {
  color: var(--title-ink);
  font-size: var(--fs-body-lg);
  line-height: 1.28;
  margin-top: 11px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap-card);
  width: 100%;
  max-width: 1262px;
  margin: 0 auto;
}

.product-card-link {
  text-decoration: none;
  display: block;
  color: inherit;
}

.product-card {
  position: relative;
  height: 245px;
  overflow: hidden;
  background: #eef1f6;
  border-radius: var(--radius-xs);
  border: 1px solid rgba(var(--accent-deep-rgb), 0.1);
  box-shadow: var(--shadow-card); /* was 0 10px 24px — collapsed onto the shared card shadow */
  transition: transform var(--t-slow) var(--ease-lift), box-shadow var(--t-slow) ease, border-color var(--t-slow) ease;
}

.product-card:hover {
  transform: translateY(-8px);
  border-color: rgba(var(--accent-deep-rgb), 0.35);
  box-shadow: var(--shadow-card-hover), 0 0 20px rgba(var(--accent-deep-rgb), 0.08);
}

.product-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(85%) contrast(105%);
  transition: filter var(--t-slower) ease, transform var(--t-slowest) var(--ease-lift);
}

.product-card:hover img {
  filter: grayscale(0%) contrast(110%);
  transform: scale(1.06);
}

/* High-Tech HUD Corners */
.product-hud-corner {
  position: absolute;
  width: 8px;
  height: 8px;
  border-color: rgba(var(--accent-deep-rgb), 0.4);
  border-style: solid;
  z-index: 3;
  pointer-events: none;
  opacity: 0.4;
  transition: opacity var(--t-med) ease, border-color var(--t-med) ease, transform var(--t-med) ease;
}

.product-hud-corner.tl {
  top: 8px;
  left: 8px;
  border-width: 1.5px 0 0 1.5px;
}

.product-hud-corner.tr {
  top: 8px;
  right: 8px;
  border-width: 1.5px 1.5px 0 0;
}

.product-hud-corner.bl {
  bottom: 8px;
  left: 8px;
  border-width: 0 0 1.5px 1.5px;
}

.product-hud-corner.br {
  bottom: 8px;
  right: 8px;
  border-width: 0 1.5px 1.5px 0;
}

.product-card:hover .product-hud-corner {
  opacity: 1;
  border-color: var(--accent-deep);
  transform: scale(1.15);
}

/* Futuristic Scanline Beam on Hover */
.product-scan-beam {
  position: absolute;
  top: -100%;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, transparent 0%, rgba(var(--accent-deep-rgb), 0.08) 50%, rgba(0, 119, 255, 0.18) 51%, transparent 52%);
  z-index: 2;
  pointer-events: none;
  opacity: 0;
}

.product-card:hover .product-scan-beam {
  opacity: 1;
  animation: cardScanBeam 1.8s ease-in-out infinite;
}

@keyframes cardScanBeam {
  0% {
    transform: translateY(0%);
  }

  100% {
    transform: translateY(200%);
  }
}

.product-card h3 {
  position: absolute;
  top: 14px;
  left: 50%;
  transform: translateX(-50%);
  color: var(--ink);
  font-size: var(--fs-body-xl);
  letter-spacing: 1.5px;
  background: rgba(var(--white-rgb), 0.85);
  backdrop-filter: blur(6px);
  padding: 4px 16px;
  border-radius: var(--radius-3xl);
  border: 1px solid rgba(var(--accent-deep-rgb), 0.15);
  box-shadow: 0 4px 12px rgba(var(--ink-rgb), 0.06);
  z-index: 3;
  transition: all var(--t-med) ease;
}

.product-card:hover h3 {
  background: var(--ink);
  color: var(--white);
  border-color: var(--accent-deep);
  box-shadow: 0 6px 16px rgba(var(--accent-deep-rgb), 0.25);
}

.environment {
  position: relative;
  height: 520px;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.environment::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(var(--bg-rgb), 0.92) 0%, rgba(var(--bg-rgb), 0.78) 38%, rgba(var(--bg-rgb), 0.15) 75%);
  z-index: 1;
  pointer-events: none;
}

.environment-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 70% center;
  z-index: 0;
}

.environment-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1147px;
  margin: 0 auto;
  padding: 0 40px;
}

.environment h2 {
  position: relative;
  text-align: left;
  color: var(--ink);
  font-size: var(--fs-h1-lg);
  letter-spacing: 1.4px;
  line-height: 1.25;
  max-width: 580px;
  margin: 0;
  text-transform: uppercase;
}

.industries {
  min-height: 588px;
  padding: var(--section-pad) 0 70px;
  text-align: center;
  background: var(--white);
  position: relative;
  overflow: hidden;
}

.industries-head {
  width: 618px;
  margin: 0 auto 35px;
}

.industry-slider-wrapper {
  position: relative;
  max-width: 1240px;
  margin: 0 auto;
  padding: 10px 55px;
  display: flex;
  align-items: center;
}

.industry-slider-track-container {
  overflow: hidden;
  width: 100%;
  padding: 15px 0 25px;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
}

.industry-slider-track-container:active {
  cursor: grabbing;
}

.industry-slider-track {
  display: flex;
  gap: var(--gap-card);
  transition: transform var(--t-slowest) cubic-bezier(0.25, 1, 0.5, 1);
  will-change: transform;
}

/* 4 Cards on Desktop View with Clean Tech Border */
.industry {
  flex: 0 0 calc((100% - (3 * 24px)) / 4);
  width: calc((100% - (3 * 24px)) / 4);
  min-width: 0;
  height: 315px;
  background: var(--white);
  border: 1.5px solid rgba(var(--accent-deep-rgb), 0.18);
  border-radius: var(--radius-xl);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform var(--t-slow) var(--ease-lift), border-color var(--t-slow) ease, box-shadow var(--t-slow) ease;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  flex-shrink: 0;
  cursor: pointer;
}

.industry:hover {
  transform: translateY(-8px);
  border-color: var(--accent-deep);
  box-shadow: 0 18px 36px rgba(var(--accent-deep-rgb), 0.18);
}

.industry-img-wrap {
  width: 100%;
  height: 190px;
  overflow: hidden;
  position: relative;
  background: #f0f2f6;
}

.industry-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(80%) contrast(105%);
  transition: filter var(--t-slower) ease, transform var(--t-slowest) var(--ease-lift);
}

.industry:hover .industry-img-wrap img {
  filter: grayscale(0%) contrast(110%);
  transform: scale(1.08);
}

/* Card Info Area */
.industry-info {
  padding: 16px 14px 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-grow: 1;
  background: var(--white);
  text-align: center;
  position: relative;
  z-index: 2;
}

.industry-title {
  color: var(--ink);
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  line-height: 1.3;
  transition: color var(--t-med) ease, transform var(--t-med) ease;
}

.industry:hover .industry-title {
  color: var(--accent-deep);
  transform: translateY(-2px);
}

/* Slider Nav Arrows */
.industry-slider-arrow {
  position: absolute;
  top: calc(50% - 10px);
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: var(--radius-round);
  background: var(--white);
  border: 1.5px solid rgba(var(--accent-deep-rgb), 0.2);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  box-shadow: 0 4px 14px rgba(var(--ink-rgb), 0.08);
  transition: all var(--t-med) ease;
}

.industry-slider-arrow:hover {
  background: var(--ink);
  color: var(--white);
  border-color: var(--ink);
  box-shadow: 0 6px 20px rgba(var(--accent-deep-rgb), 0.25);
  transform: translateY(-50%) scale(1.08);
}

.industry-slider-arrow.prev {
  left: 0px;
}

.industry-slider-arrow.next {
  right: 0px;
}

/* Slider Pagination Dots */
.industry-slider-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}

.industry-dot {
  width: 10px;
  height: 10px;
  border-radius: var(--radius-round);
  background: rgba(var(--accent-deep-rgb), 0.2);
  border: none;
  cursor: pointer;
  padding: 0;
  transition: all var(--t-med) ease;
}

.industry-dot.active {
  width: 28px;
  border-radius: var(--radius-xs);
  background: var(--accent-deep);
  box-shadow: 0 0 10px rgba(var(--accent-deep-rgb), 0.4);
}

/* Responsive Breakpoints */
@media (max-width: 1024px) {
  .industry-slider-wrapper {
    padding: 10px 48px;
  }

  .industry {
    flex: 0 0 calc((100% - (1 * 20px)) / 2);
    width: calc((100% - (1 * 20px)) / 2);
    height: 300px;
  }

  .industry-slider-track {
    gap: 20px;
  }
}

@media (max-width: 600px) {
  .industry-slider-wrapper {
    padding: 10px 38px;
  }

  .industry {
    flex: 0 0 100%;
    width: 100%;
    height: 310px;
  }

  .industry-img-wrap {
    height: 190px;
  }

  .industry-slider-track {
    gap: 16px;
  }

  .industry-slider-arrow {
    width: 34px;
    height: 34px;
  }
}

.problem {
  position: relative;
  height: 570px;
  background:
    linear-gradient(rgba(var(--bg-rgb), .88), rgba(var(--bg-rgb), .88)),
    url("../images/problem-bg.png") center/cover no-repeat;
}

.problem::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 51px;
  width: 7px;
  height: 486px;
  background: rgba(var(--white-rgb), .85);
}

/* ── CTA SECTION ────────────────────────────────────────────────────────── */
.cta {

  background: linear-gradient(rgba(var(--bg-rgb), .88), rgba(var(--bg-rgb), .88)),
    url("../images/problem-bg.png") center/cover no-repeat;
  padding: 80px var(--gutter);
  position: relative;
  overflow: hidden;
  z-index: 5;
}

.cta+.footer {
  margin-top: 0;
}

.cta-container {
  max-width: 1258px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
}

.cta-content {
  flex: 1;
}

.cta h2 {
  color: var(--title-ink);
  font-size: var(--fs-h2-lg);
  line-height: 1.25;
  letter-spacing: 1.5px;
}

.cta h2 .highlight {
  color: var(--accent);
}

.cta-sub {
  color: var(--gray-mid);
  font-size: var(--fs-body-lg);
  margin-top: 12px;
  font-weight: var(--fw-regular);
}

.cta-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.btn-cta-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 28px;
  border-radius: var(--radius-md);
  background: var(--accent);
  color: var(--white);
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: background var(--t-base) ease, transform var(--t-base) ease, box-shadow var(--t-base) ease;
}

/* Darken a step + accent-tinted shadow — the grammar .btn-blue:hover speaks.
   (Replaced an off-palette purple glow, rgba(90, 69, 255, .5), left over from
   an older theme.) */
.btn-cta-primary:hover {
  background: var(--accent-deep);
  box-shadow: 0 10px 26px rgba(var(--accent-rgb), 0.35);
  transform: translateY(-2px);
}

.btn-arrow {
  margin-left: 8px;
  transition: transform var(--t-base) ease;
  display: inline-block;
}

.btn-cta-primary:hover .btn-arrow {
  transform: translateX(4px);
}

/* ── ABOUT HERO SECTION ─────────────────────────────────────────────────── */
.about-hero {
  width: 100%;
  min-height: 700px;
  background: url("../images/abt-hero.png") no-repeat center right / cover;
  padding: 0 var(--gutter);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

/* ── ABOUT STORY SECTION ────────────────────────────────────────────────── */
.about-story {
  padding: var(--section-pad-lg) 0;
  background: var(--white);
}

/* ── WHY CHOOSE US SECTION ───────────────────────────────────────────────── */
.why-choose-us {
  padding: var(--section-pad-lg) 0;
  background: #f4f4f5;
  position: relative;
  overflow: hidden;
}

/* ── HUD ANIMATIONS ──────────────────────────────────────────────────────── */

.timeline {
  position: relative;
  padding-left: 36px;
}

.timeline::before {
  content: "";
  position: absolute;
  top: 8px;
  bottom: 8px;
  left: 6px;
  width: 2px;
  background: rgba(var(--accent-rgb), 0.22);
}


.footer {
  background: linear-gradient(180deg, var(--footer-top) 0%, var(--footer-bottom) 100%);
  color: var(--white);
  padding-top: 85px;
  position: relative;
  overflow: hidden;
  border-top: 1.5px solid rgba(var(--accent-deep-rgb), 0.4);
  box-shadow: inset 0 1px 0 rgba(var(--white-rgb), 0.05);
}

/* Subtle top glowing laser line */
.footer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1.5px;
  background: linear-gradient(90deg, transparent 5%, var(--accent-deep) 30%, var(--sky) 50%, var(--accent-deep) 70%, transparent 95%);
  box-shadow: 0 0 14px rgba(var(--sky-rgb), 0.6);
  z-index: 3;
}

.footer-grid {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1258px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 386px 170px 300px 120px;
  justify-content: space-between;
  gap: 46px;
}

.footer-logo {
  width: 244px;
  margin-bottom: 24px;
}

.footer p,
.footer a,
.footer li {
  color: var(--footer-text);
  font-size: var(--fs-body-lg);
  line-height: 1.90;
  font-weight: var(--fw-light);
}

.footer a:hover {
  color: var(--sky);
  transition: color var(--t-base) ease;
}

.footer h4 {
  color: var(--white);
  font-size: var(--fs-h4);
  line-height: 1.2;
  margin-bottom: 15px;
  font-weight: var(--fw-semibold);
}

.footer-bottom {
  width: 100%;
  max-width: 1280px;
  margin: 35px auto 0;
  padding: 20px 55px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(var(--white-rgb), 0.1);
  box-sizing: border-box;
  padding-bottom: 18px;
  position: relative;
  z-index: 2;
}

.footer-bottom p {
  margin: 0;
  color: var(--slate-400);
  font-size: var(--fs-2xs);
}

.socials {
  display: flex;
  gap: 21px;
}

.socials img {
  width: 37px;
  height: 37px;
  object-fit: contain;
  transition: transform var(--t-med) ease, filter var(--t-med) ease;
}

.socials img:hover {
  transform: translateY(-3px) scale(1.1);
  filter: drop-shadow(0 4px 10px rgba(var(--sky-rgb), 0.4));
}

.copyright {
  width: 100%;
  max-width: 1258px;
  margin: 31px auto 0;
  color: var(--gray-mid);
  font-size: var(--fs-body-sm);
  letter-spacing: .8px;
}

/* ── VISION & MISSION SECTION ───────────────────────────────────────────── */
.vision-mission {
  padding: 245px 0 90px 0;
  background: var(--white);
}

.vision-mission-hero {
  position: relative;
  z-index: 1;
  width: 100%;
  overflow: hidden;
  border-radius: var(--radius-xl);
}

.vision-mission-cards {
  /*width: 1482px;*/
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 80px;
  /*left: 12%;*/
  margin-top: -120px;
  position: relative;
  z-index: 2;
  padding: 0 60px;
}

.vision-mission-card {
  background: var(--surface-tint);
  border-radius: var(--radius-xl);
  padding: 64px 40px 48px;
  position: relative;
  text-align: center;
  box-shadow: 0 12px 34px rgba(var(--ink-rgb), 0.05);
  border: 1px solid rgba(var(--ink-rgb), 0.04);
}

.vision-mission-card .card-icon {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 64px;
  z-index: 3;
}

.vision-mission-card .card-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.vision-mission-card h3 {
  font-size: var(--fs-h3);
  color: var(--ink);
  margin-bottom: 16px;
  font-family: var(--font-display);
  letter-spacing: 0.5px;
}

.vision-mission-card p {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--muted);
  font-weight: var(--fw-regular);
  margin: 0;
}

.vision-mission-card ul {
  list-style: none;
  padding: 0;
  margin: 15px auto 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  column-gap: 20px;
  row-gap: 8px;
  text-align: left;
  width: 100%;
}

.vision-mission-card ul li {
  position: relative;
  padding-left: 14px;
  margin-bottom: 0;
  line-height: 1.4;
  font-size: var(--fs-body-sm);
  color: var(--muted);
}

.vision-mission-card ul li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 9px;
  width: 5px;
  height: 5px;
  background: var(--accent);
  border-radius: var(--radius-round);
  transform: translateY(-50%);
}

/* ── LEADERSHIP SECTION ─────────────────────────────────────────────────── */
.leadership {
  padding: 85px 0 120px 0;
  background: var(--white);
}

.leadership .section-title {
  font-size: clamp(26px, 3.2vw, 36px);
  color: var(--ink);
  margin-bottom: 32px;
  text-align: left;
}

/* ── FACILITY SECTION ───────────────────────────────────────────────────── */
.facility {
  padding: 85px 0 95px 0;
  background: var(--white);
  border-top: 1px solid rgba(var(--ink-rgb), 0.08);
}

.facility-grid {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 80px;
  align-items: start;
}

.facility-left {
  display: flex;
  flex-direction: column;
}

.facility-left h2 {
  color: var(--ink);
  font-size: clamp(26px, 4vw, 36px);
  line-height: 1.2;
  letter-spacing: 1.5px;
  margin-top: 4px;
}

.facility-gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap-card);
}

.facility-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  text-align: center;
}

.facility-photo {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(var(--ink-rgb), 0.04);
}

.facility-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(100%);
  transition: transform var(--t-slower) ease, filter var(--t-slower) ease;
}

.facility-item:hover .facility-photo img {
  filter: grayscale(0%);
  transform: scale(1.05);
}

.facility-caption {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--surface-tint);
  padding: 18px 24px;
  border-radius: var(--radius-md);
  width: fit-content;
  border: 1px solid rgba(var(--ink-rgb), 0.04);
}

.facility-caption p {
  font-size: var(--fs-body-sm);
  color: var(--ink);
  font-weight: var(--fw-medium);
  margin: 0;
}

/* ── RESPONSIVE STYLES ─────────────────────────────────────────────────── */

/* Desktop Hamburger & Mobile Menu Base Styles */
.nav-toggle {
  display: none;
  position: relative;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: transparent;
  border: none;
  cursor: pointer;
  z-index: 100;
  padding: 0;
}

.hamburger-bar {
  width: 100%;
  height: 2.5px;
  background-color: var(--ink);
  border-radius: 2px;
  transition: all var(--t-med) cubic-bezier(0.25, 0.1, 0.25, 1);
}

.nav-toggle.active .hamburger-bar:nth-child(1) {
  transform: translateY(8.75px) rotate(45deg);
}

.nav-toggle.active .hamburger-bar:nth-child(2) {
  opacity: 0;
}

.nav-toggle.active .hamburger-bar:nth-child(3) {
  transform: translateY(-8.75px) rotate(-45deg);
}

/* Mobile Drawer Overlay */
.mobile-menu {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  z-index: 10000;
  display: flex;
  justify-content: flex-end;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--t-med) ease, visibility var(--t-med);
}

.mobile-menu.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.mobile-menu-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(var(--ink-rgb), 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  cursor: pointer;
}

.mobile-menu-panel {
  position: relative;
  width: 100%;
  max-width: 360px;
  height: 100%;
  background: var(--white);
  display: flex;
  flex-direction: column;
  box-shadow: -10px 0 35px rgba(0, 0, 0, 0.2);
  transform: translateX(100%);
  transition: transform var(--t-slow) var(--ease-drawer);
  z-index: 2;
}

.mobile-menu.active .mobile-menu-panel {
  transform: translateX(0);
}

.mobile-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  background: var(--white);
}

.mobile-menu-logo img {
  width: 135px;
  height: auto;
  display: block;
}

.mobile-menu-close {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-round);
  background: #f1f3f7;
  border: 1px solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--ink);
  transition: background var(--t-fast) ease, transform var(--t-base) ease, color var(--t-fast) ease;
  padding: 0;
}

.mobile-menu-close:hover,
.mobile-menu-close:focus-visible {
  background: #e2e6ee;
  color: var(--accent);
  transform: rotate(90deg);
}

.mobile-menu-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--gap-card);
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 100%;
}

.mobile-nav-links>a,
.mobile-dropdown-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: var(--fs-body-md);
  font-weight: var(--fw-semibold);
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: background var(--t-fast) ease, color var(--t-fast) ease;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
}

.mobile-nav-links>a:hover,
.mobile-dropdown-toggle:hover,
.mobile-dropdown-toggle[aria-expanded="true"] {
  background: rgba(var(--accent-rgb), 0.08);
  color: var(--accent);
}

.mobile-dropdown {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.mobile-dropdown-toggle .dropdown-caret {
  transition: transform var(--t-base) ease;
}

.mobile-dropdown-toggle[aria-expanded="true"] .dropdown-caret {
  transform: rotate(180deg);
}

.mobile-submenu {
  list-style: none;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height var(--t-slow) var(--ease-menu), opacity var(--t-med) ease;
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 4px 0 6px 12px;
  padding-left: 12px;
  border-left: 2px solid rgba(var(--accent-rgb), 0.25);
}

.mobile-submenu.open {
  max-height: 300px;
  opacity: 1;
  padding-top: 6px;
  padding-bottom: 6px;
}

.mobile-submenu li a {
  display: block;
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-semibold);
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  transition: color var(--t-fast) ease, background var(--t-fast) ease, transform var(--t-fast) ease;
}

.mobile-submenu li a:hover,
.mobile-submenu li a:focus-visible {
  color: var(--accent);
  background: rgba(var(--accent-rgb), 0.08);
  transform: translateX(4px);
}

.mobile-menu-footer {
  padding-top: 16px;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.btn-mobile-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 48px;
  background: var(--ink);
  color: var(--white);
  border-radius: var(--radius-lg);
  font-weight: var(--fw-semibold);
  font-size: var(--fs-body);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: background var(--t-base) ease, transform var(--t-fast) ease;
}

.btn-mobile-cta:hover {
  background: var(--accent);
  transform: translateY(-1px);
}

/* ── LAPTOP VIEWPORTS (1024px – 1440px) ────────────────────────────────── */
@media (max-width: 1280px) {
  .logo {
    width: 210px;
  }

  .about-grid {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    width: 100%;
    max-width: 1140px;
    padding: 0 40px;
  }

  .excellence {
    padding: 60px 40px;
  }

  .product-grid {
    width: 100%;
    max-width: 1140px;
    grid-template-columns: repeat(4, 1fr);
    padding: 0 40px;
  }

  .footer-grid {
    width: 100%;
    max-width: 1140px;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 30px;
    padding: 0 40px;
  }

  .copyright {
    width: 100%;
    max-width: 1140px;
    padding: 0 40px;
  }

  .copyright .russo {
    font-size: var(--fs-2xs);
  }

  .cta {
    padding: 80px 40px;
  }

  .cta-container {
    width: 100%;
    max-width: 1140px;
    padding: 0;
  }

  .about-hero {
    padding: 0 40px;
  }

  .vision-mission-cards {
    width: 100%;
    max-width: 1140px;
    left: auto;
    margin-left: auto;
    margin-right: auto;
    padding: 0 40px;
    margin-top: -100px;
    gap: 30px;
  }



  .facility-grid {
    grid-template-columns: 240px 1fr;
    gap: 40px;
  }

  .facility-gallery {
    gap: 16px;
  }
}

@media (max-width: 1100px) {
  .excellence {
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .metrics,
.excellence-line {
    position: static;
    width: auto;
  }

  .metrics {
    margin-top: 0;
    width: 100%;
  }
}


/* ── TABLET & MOBILE VIEWPORTS (under 1024px) ─────────────────────────── */
@media (max-width: 1023px) {
