  }

  .about-story,
.why-choose-us {
    padding: var(--section-pad-md) 0;
  }

  .vision-mission-cards {
    width: 100%;
    left: auto;
    margin-left: auto;
    margin-right: auto;
    grid-template-columns: 1fr;
    gap: 60px;
    margin-top: -60px;
    padding: 0 20px;
  }

  .vision-mission-card {
