  }

  .environment h2 {
    font-size: 26px;
    line-height: 1.3;
    max-width: 100%;
  }

  .problem {
    height: auto;
    padding: var(--section-pad-sm) 0;
  }

  .problem::after {
    display: none;
  }

  .footer {
    height: auto;
    padding: var(--section-pad-sm) 0 32px;

  }

  .footer-grid {
    width: min(100% - 32px, 720px);
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    padding: 0;
  }

  .copyright {
    width: min(100% - 32px, 720px);
    padding: 0;
  }

  .cta {

    padding: var(--section-pad-sm) 0;
    background: linear-gradient(rgba(var(--bg-rgb), .88), rgba(var(--bg-rgb), .88)),
      url("../images/problem-bg.png") center/cover no-repeat;
  }

  .cta-container {
    width: min(100% - 32px, 720px);
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
  }

  .cta-actions {
    flex-shrink: 1;
  }

  .about-hero {
    aspect-ratio: auto;
    min-height: auto;
    background: #f4f4f6;
